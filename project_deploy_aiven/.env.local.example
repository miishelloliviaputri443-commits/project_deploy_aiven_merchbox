DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_DATABASE=merchandise_db
DB_CA_CERT=
# Set to true when MYSQL_CA_CERT is configured. Aiven's default connection works
# without a CA certificate, but setting a CA is recommended for production.
DB_SSL_REJECT_UNAUTHORIZED=false

# DB_* aliases are also supported for existing deployments.
